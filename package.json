{
  "name": "agendareguas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts && cp src/types/database.ts supabase/functions/_shared/database.types.ts",
    "check": "npm run typecheck && npm run lint && npm run fn:check",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "fn:serve": "supabase functions serve --env-file supabase/functions/.env",
    "fn:check": "deno check supabase/functions/*/index.ts && cd supabase/functions && deno lint",
    "fn:deploy": "supabase functions deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "deno": "^2.9.6",
    "oxlint": "^1.89.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "web-push": "^3.6.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
