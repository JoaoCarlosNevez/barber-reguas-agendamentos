# ---------------------------------------------------------------------------
# Frontend (Vite) — copie para .env.local
# Valores locais: `npx supabase status -o env`
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole-a-anon-key-aqui
# Chave pública VAPID (Web Push) — a mesma de supabase/functions/.env
VITE_VAPID_PUBLIC_KEY=cole-a-chave-publica-vapid-aqui

# ---------------------------------------------------------------------------
# Edge Functions — supabase/functions/.env (local) e `supabase secrets set` (remoto)
#   npx supabase secrets set --env-file supabase/functions/.env
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:contato@suabarbearia.com.br
# APP_ORIGINS=http://localhost:5173,https://seu-dominio.com.br   (CORS, separado por vírgula)
